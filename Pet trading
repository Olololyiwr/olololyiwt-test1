--==================================================
-- HELPERS
--==================================================

local function new(className, properties, parent)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function corner(parent, radius)
    return new("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, parent)
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or COLORS.Orange,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, parent)
end

local function tween(object, properties, duration, style)
    local info = TweenInfo.new(
        duration or 0.2,
        style or Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )

    local animation = TweenService:Create(object, info, properties)
    animation:Play()

    return animation
end

local function label(parent, text, size, position, textSize, color)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        Size = size,
        Position = position,
        Font = Enum.Font.GothamSemibold,
        TextSize = textSize or 13,
        TextColor3 = color or COLORS.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = false
    }, parent)
end

local function button(parent, text, size, position, color)
    local object = new("TextButton", {
        Size = size,
        Position = position,
        BackgroundColor3 = color or COLORS.Orange,
        BorderSizePixel = 0,
        Text = text or "",
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        AutoButtonColor = false
    }, parent)

    corner(object, 8)
    return object
end

local function addGloss(parent, transparency)
    local gloss = new("Frame", {
        Name = "Gloss",
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = transparency or 0.92,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0.45, 0),
        Position = UDim2.new(0, 0, 0, 0),
        ZIndex = parent.ZIndex + 1
    }, parent)

    corner(gloss, 8)

    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1)
        })
    }, gloss)

    return gloss
end

local function addNeon(parent, color)
    local outline = stroke(parent, color or COLORS.Orange, 1.5, 0.15)

    task.spawn(function()
        while parent and parent.Parent do
            tween(outline, {
                Transparency = 0.55
            }, 1)

            task.wait(1)

            if not outline or not outline.Parent then
                break
            end

            tween(outline, {
                Transparency = 0.1
            }, 1)

            task.wait(1)
        end
    end)

    return outline
end

