--==================================================

local Pill=new("TextButton",{
    Name="RestoreButton",
    AnchorPoint=Vector2.new(.5,0),
    Position=UDim2.new(.5,0,0,-55),
    Size=UDim2.fromOffset(165,38),
    BackgroundColor3=PANEL,
    Text="🐾 PET TRADING HUB",
    TextColor3=ORANGE,
    Font=Enum.Font.GothamBold,
    TextSize=12,
    BorderSizePixel=0,
    Visible=true,
    AutoButtonColor=false
},Gui)

corner(Pill,20)
addNeon(Pill,ORANGE)

local isMinimized=false
local busy=false

Minimize.Activated:Connect(function()
    if busy or isMinimized then return end
    busy=true
    isMinimized=true

    tween(Main,TweenInfo.new(.25,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
        Position=UDim2.new(.5,0,1.2,0),
        BackgroundTransparency=1
    })

    task.wait(.22)
    Main.Visible=false
    Pill.Visible=true

    tween(Pill,TweenInfo.new(.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
        Position=UDim2.new(.5,0,0,12)
    })

    busy=false
end)

Pill.Activated:Connect(function()
    if busy or not isMinimized then return end
    busy=true

    tween(Pill,TweenInfo.new(.2),{
        Position=UDim2.new(.5,0,0,-55)
    })

    task.wait(.18)

    Pill.Visible=false
    Main.Visible=true
    Main.Position=UDim2.new(.5,0,.58,0)
    Main.BackgroundTransparency=1

    tween(Main,TweenInfo.new(.32,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{
        Position=UDim2.new(.5,0,.52,0),
        BackgroundTransparency=0
    })

    isMinimized=false
    busy=false
end)

