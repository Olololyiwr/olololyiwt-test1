        UDim2.new(1, -20, 0, 26),
        UDim2.new(0, 12, 0, 5),
        15,
        color
    )

    headerTitle.Font = Enum.Font.GothamBlack
    applyTitleGradient(headerTitle, category)

    label(
        header,
        "Select a pet to open the purchase panel",
        UDim2.new(1, -20, 0, 19),
        UDim2.new(0, 12, 0, 32),
        10,
        COLORS.SubText
    )

    local petList = new("ScrollingFrame", {
        Name = "PetList",
        Size = UDim2.new(1, -6, 1, -68),
        Position = UDim2.new(0, 0, 0, 65),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = color,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y
    }, Content)

    new("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, petList)

    new("UIPadding", {
        PaddingBottom = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 5)
    }, petList)

    local petData

    if category == "Gold" then
        petData = GoldPets
    elseif category == "Rainbow" then
        petData = RainbowPets
    else
        petData = ColoredPets
    end

    local function renderPets(searchText)
        for _, child in ipairs(petList:GetChildren()) do
            if child:IsA("GuiObject")
                and not child:IsA("UIListLayout")
                and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end

        searchText = string.lower(searchText or "")

        for _, pet in ipairs(petData) do
            local petName = string.lower(tostring(pet.name))
            local petId = tostring(pet.id)

            if searchText == ""
                or string.find(petName, searchText, 1, true)
                or string.find(petId, searchText, 1, true) then

                makePetButton(petList, pet, category)
            end
        end
    end

    renderPets(SearchBox.Text)

    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        if CurrentCategory == category then
            renderPets(SearchBox.Text)
        end
    end)
end

