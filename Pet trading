        BackgroundTransparency=1
    },panel)

    local expanded=false
    local mode="Single"
    local busy=false
    local selectedOne=nil
    local selectedMulti={}
    local quantity=1
    local dropdown=false

    local single=button(body,"SINGLE",
        UDim2.new(0,0,0,0),UDim2.new(.5,-3,0,30),ORANGE,nil,9)

    local multi=button(body,"MULTI",
        UDim2.new(.5,3,0,0),UDim2.new(.5,-3,0,30),PANEL,nil,9)

    local choose=button(body,"Choose pet  ▼",
        UDim2.new(0,0,0,36),UDim2.new(1,0,0,32),PANEL,nil,10)
    choose.TextXAlignment=Enum.TextXAlignment.Left

    local info=label(body,"Choose a pet",
        UDim2.new(0,2,0,70),UDim2.new(1,-4,0,19),ORANGE,10,true)

    local menu=new("Frame",{
        Position=UDim2.new(0,0,0,105),
        Size=UDim2.new(1,0,0,115),
        BackgroundColor3=PANEL,
        BorderSizePixel=0,
        Visible=false,
        ZIndex=30
    },body)

    corner(menu,8)
    stroke(menu,ORANGE,1,.3)

    local search=new("TextBox",{
        Position=UDim2.new(0,5,0,5),
        Size=UDim2.new(1,-10,0,25),
        BackgroundColor3=CARD,
        PlaceholderText="Search inventory...",
        Text="",
        TextColor3=WHITE,
        PlaceholderColor3=MUTED,
        Font=Enum.Font.Gotham,
        TextSize=10,
        ClearTextOnFocus=false,
        BorderSizePixel=0,
        ZIndex=31
    },menu)
    corner(search,6)

    local list=new("ScrollingFrame",{
        Position=UDim2.new(0,5,0,34),
        Size=UDim2.new(1,-10,1,-39),
        BackgroundTransparency=1,
        BorderSizePixel=0,
        ScrollBarThickness=3,
        CanvasSize=UDim2.new(),
        AutomaticCanvasSize=Enum.AutomaticSize.Y,
        ZIndex=31
    },menu)

    new("UIListLayout",{
        Padding=UDim.new(0,3)
    },list)

    local minus=button(body,"−",
        UDim2.new(0,0,0,100),UDim2.fromOffset(38,30),PANEL,nil,17)

    local quantityBox=new("TextBox",{
        Position=UDim2.new(0,43,0,100),
        Size=UDim2.new(1,-126,0,30),
        BackgroundColor3=PANEL,
        Text="1",
        TextColor3=WHITE,
        Font=Enum.Font.GothamBold,
        TextSize=12,
        BorderSizePixel=0,
        ClearTextOnFocus=false
    },body)
    corner(quantityBox,7)

    local plus=button(body,"+",
        UDim2.new(1,-78,0,100),UDim2.fromOffset(38,30),PANEL,nil,17)

    local max=button(body,"MAX",
        UDim2.new(1,-38,0,100),UDim2.fromOffset(38,30),PANEL,nil,8)

    local selectAll=button(body,"☑ SELECT ALL",
        UDim2.new(0,0,0,137),UDim2.new(1,0,0,28),PANEL,nil,9)

    local sellOne=button(body,"SELL ONE",
        UDim2.new(0,0,0,174),UDim2.new(1,0,0,34),ORANGE,nil,10)

    local sellSelected=button(body,"SELL SELECTED",
        UDim2.new(0,0,0,174),UDim2.new(1,0,0,34),GREEN,nil,10)
    sellSelected.Visible=false

    local function updateInfo()
        if mode=="Single" then
            info.Text=selectedOne
                and ("IN INVENTORY: "..getCount(selectedOne))
                or "Choose one pet"
            choose.Text=selectedOne
                and (getPetName(selectedOne).."  ▼")
                or "Choose pet  ▼"
        else
            local types,total=0,0
            for id,selected in pairs(selectedMulti) do
                if selected then
                    local c=getCount(id)
                    if c>0 then
                        types+=1
                        total+=c
                    end
                end
            end
            info.Text="Selected: "..types.." types • "..total.." pets"
            choose.Text="CHOOSE PETS  ▼"
        end
    end

    local function updateMode()
        local isSingle=mode=="Single"
        single.BackgroundColor3=isSingle and ORANGE or PANEL
        multi.BackgroundColor3=not isSingle and ORANGE or PANEL
        minus.Visible=isSingle
        plus.Visible=isSingle
        max.Visible=isSingle
        quantityBox.Visible=isSingle
        selectAll.Visible=not isSingle
        sellOne.Visible=isSingle
        sellSelected.Visible=not isSingle
        updateInfo()
    end

    local function refreshList()
        for _,obj in ipairs(list:GetChildren()) do
            if obj:IsA("GuiObject") then obj:Destroy() end
        end

        local query=search.Text:lower()
        local found=0

        for _,entry in ipairs(getInventoryPets()) do
            if query=="" or entry.name:lower():find(query,1,true)
                or tostring(entry.id):find(query,1,true) then

                found+=1

                local selected=mode=="Single"
                    and selectedOne==entry.id
                    or mode=="Multi" and selectedMulti[entry.id]

                local row=button(list,
                    (selected and "✓ " or "○ ")..entry.name.."  x"..entry.count,
                    UDim2.new(),UDim2.new(1,-3,0,29),
                    selected and Color3.fromRGB(75,48,30) or CARD,nil,9)

                row.TextXAlignment=Enum.TextXAlignment.Left
                row.ZIndex=32

                row.Activated:Connect(function()
                    if busy then return end

                    if mode=="Single" then
                        selectedOne=entry.id
                        quantity=1
                        quantityBox.Text="1"
                        menu.Visible=false
                        dropdown=false
                    else
                        selectedMulti[entry.id]=not selectedMulti[entry.id] or nil
                        refreshList()
                    end

                    updateInfo()
                end)
            end
        end

        if found==0 then
            local empty=label(list,"No pets found",
                UDim2.new(),UDim2.new(1,0,0,25),MUTED,10,false)
            empty.ZIndex=32
        end
    end

    local function setQuantity(value)
        local count=selectedOne and getCount(selectedOne) or 1
        quantity=math.clamp(math.floor(tonumber(value) or 1),1,math.max(1,count))
        quantityBox.Text=tostring(quantity)
    end

    local function sendSell(id,amount)
        if not SellRemote then return false,0 end

        local before=getCount(id)
        if before<=0 then return false,0 end

        amount=math.min(amount,before)

        local ok=pcall(function()
            SellRemote:FireServer("sell",id,amount)

            if getHeldPet()==tostring(id) and PickAndDropRemote then
                PickAndDropRemote:FireServer("Sell")
            end
        end)

        if not ok then return false,0 end

        local deadline=os.clock()+5
        repeat
            task.wait(.1)
            local sold=math.max(0,before-getCount(id))
            if sold>0 then return true,sold end
        until os.clock()>=deadline

        return false,0
    end

    local function setBusy(value)
        busy=value
        sellOne.Active=not value
        sellSelected.Active=not value
        sellOne.Text=value and "SELLING..." or "SELL ONE"
        sellSelected.Text=value and "SELLING..." or "SELL SELECTED"
    end

    head.Activated:Connect(function()
        expanded=not expanded
        tween(panel,TweenInfo.new(.2),{
            Size=UDim2.new(1,-4,0,expanded and 338 or 43)
        })
        arrow.Text=expanded and "▲" or "▼"
        if not expanded then
            menu.Visible=false
            dropdown=false
        end
    end)

    single.Activated:Connect(function()
        mode="Single"
        menu.Visible=false
        dropdown=false
        updateMode()
        refreshList()
    end)

    multi.Activated:Connect(function()
        mode="Multi"
        menu.Visible=false
        dropdown=false
        updateMode()
        refreshList()
    end)

    choose.Activated:Connect(function()
        dropdown=not dropdown
        menu.Visible=dropdown
        if dropdown then refreshList() end
    end)

    search:GetPropertyChangedSignal("Text"):Connect(refreshList)

    minus.Activated:Connect(function()
        setQuantity(quantity-1)
    end)

    plus.Activated:Connect(function()
        setQuantity(quantity+1)
    end)

    max.Activated:Connect(function()
        if selectedOne then setQuantity(getCount(selectedOne)) end
    end)

    quantityBox.FocusLost:Connect(function()
        setQuantity(quantityBox.Text)
    end)

    selectAll.Activated:Connect(function()
        local entries=getInventoryPets()
        local all=true

        for _,entry in ipairs(entries) do
            if not selectedMulti[entry.id] then
                all=false
                break
            end
        end

        if all then
            table.clear(selectedMulti)
            selectAll.Text="☑ SELECT ALL"
        else
            for _,entry in ipairs(entries) do
                selectedMulti[entry.id]=true
            end
            selectAll.Text="☑ DESELECT ALL"
        end

        refreshList()
        updateInfo()
    end)

    sellOne.Activated:Connect(function()
        if busy then return end
        if not selectedOne then
            info.Text="Choose a pet first"
            return
        end

        local id=selectedOne
        local amount=math.min(quantity,getCount(id))
        if amount<=0 then
            info.Text="Pet unavailable"
            return
        end

        setBusy(true)

        task.spawn(function()
            local ok,sold=sendSell(id,amount)
            info.Text=ok and ("Sold "..sold.." "..getPetName(id))
                or "Sell not confirmed"
            task.wait(.2)
            setBusy(false)
            updateInfo()
            refreshList()
        end)
    end)

    sellSelected.Activated:Connect(function()
        if busy then return end

        local batch={}
        for id,selected in pairs(selectedMulti) do
            if selected and getCount(id)>0 then
                table.insert(batch,id)
            end
        end

        if #batch==0 then
            info.Text="Select at least one pet"
            return
        end

        setBusy(true)

        task.spawn(function()
            local total,failed=0,0

            for _,id in ipairs(batch) do
                local count=getCount(id)
                if count>0 then
                    local ok,sold=sendSell(id,count)
                    if ok then total+=sold else failed+=1 end
                end
            end

            table.clear(selectedMulti)
            info.Text="Sold "..total.." pets • Failed: "..failed
            task.wait(.2)
            setBusy(false)
            refreshList()
            updateInfo()
        end)
    end)

    updateMode()
end

