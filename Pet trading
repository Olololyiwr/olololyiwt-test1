-- TABS
--==================================================

local TabButtons={}

local function makeTab(name,text)
    local b=new("TextButton",{
        Size=UDim2.new(1,0,0,34),
        BackgroundColor3=name==CurrentTab and ORANGE or CARD,
        Text=text,
        TextColor3=WHITE,
        Font=Enum.Font.GothamBold,
        TextSize=9,
        BorderSizePixel=0,
        AutoButtonColor=false
    },Nav)

    corner(b,8)
    stroke(b,ORANGE,.8,.65)

    TabButtons[name]=b

    b.Activated:Connect(function()
        CurrentTab=name
        Search.Text=""

        for tabName,item in pairs(TabButtons) do
            tween(item,TweenInfo.new(.15),{
                BackgroundColor3=tabName==CurrentTab and ORANGE or CARD
            })
        end

        render()
    end)
end

makeTab("Main","🏠 Main")
makeTab("Gold Pet","🪙 Gold")
makeTab("Rainbow Pet","🌈 Rainbow")
makeTab("Colored Pet","🎨 Colored")
makeTab("Credits","⭐ Credits")

Search:GetPropertyChangedSignal("Text"):Connect(function()
    if CurrentTab=="Gold Pet" then
        showPets(GoldPets,"Gold")
    elseif CurrentTab=="Rainbow Pet" then
        showPets(RainbowPets,"Rainbow")
    elseif CurrentTab=="Colored Pet" then
        showPets(ColoredPets,"Colored")
    end
end)

