    elseif CurrentTab=="Gold Pet" then
        showPets(GoldPets,"Gold")
    elseif CurrentTab=="Rainbow Pet" then
        showPets(RainbowPets,"Rainbow")
    elseif CurrentTab=="Colored Pet" then
        showPets(ColoredPets,"Colored")
    elseif CurrentTab=="Credits" then
        showCredits()
    end
end

