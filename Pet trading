local function getInventory()
    local inventory = {}

    local data = LocalPlayer:FindFirstChild("Data")

    if not data then
        return inventory
    end

    local pets = data:FindFirstChild("Pets")

    if not pets then
        return inventory
    end

    for _, pet in ipairs(pets:GetChildren()) do
        local petId = tonumber(pet:GetAttribute("PetId"))

        if petId then
            inventory[petId] = (inventory[petId] or 0) + 1
        end
    end

    return inventory
end

local function getPetCount(petId)
    local inventory = getInventory()
    return inventory[petId] or 0
end

