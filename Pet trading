local function readObjectText(obj)
    local ok,value = pcall(function()
        return obj.Text
    end)

    if ok and value ~= nil then
        return tostring(value)
    end

    return nil
end

-- FIX: đọc được cả số dạng x250, 250x và số thuần trong
-- những object có tên Count / Amount / Quantity.
local function parseCount(text,allowPlain)
    if not text then return nil end

    local cleaned = tostring(text)
        :gsub(",","")
        :gsub("%s+","")

    local number = cleaned:match("[xX](%d+)")
        or cleaned:match("(%d+)[xX]")

    if number then
        return tonumber(number)
    end

    if allowPlain and cleaned:match("^%d+$") then
        return tonumber(cleaned)
    end

    return nil
end

local function getCount(id)
    if not Inventory or not id then return 0 end

    local item = Inventory:FindFirstChild(tostring(id))
    if not item then return 0 end

    -- Ưu tiên các label có tên biểu thị số lượng.
    for _,obj in ipairs(item:GetDescendants()) do
        local lowerName = string.lower(obj.Name)

        if lowerName == "itemcount"
            or lowerName == "count"
            or lowerName == "amount"
            or lowerName == "quantity" then

            local number = parseCount(readObjectText(obj),true)
            if number and number >= 0 then
                return number
            end

            local ok,value = pcall(function()
                return obj.Value
            end)

            if ok and tonumber(value) then
                return tonumber(value)
            end
        end
    end

    for _,attribute in ipairs({"ItemCount","Count","Amount","Quantity"}) do
        local value = item:GetAttribute(attribute)
        if tonumber(value) then
            return tonumber(value)
        end
    end

    -- Thử đọc số lượng trong các TextLabel khác.
    for _,obj in ipairs(item:GetDescendants()) do
        local number = parseCount(readObjectText(obj),false)
        if number and number > 0 then
            return number
        end
    end

    -- Không tìm thấy label số lượng: UI item được xem là 1 pet.
    return 1
end

local function getPetName(id)
    if not Inventory then return "Pet "..tostring(id) end

    local item = Inventory:FindFirstChild(tostring(id))
    if not item then return "Pet "..tostring(id) end

    for _,name in ipairs({"NameLabel","PetName","DisplayName","ItemName"}) do
        local label = item:FindFirstChild(name,true)
        local text = label and readObjectText(label)

        if text and text ~= "" and not tonumber(text) then
            return text
        end
    end

    for _,obj in ipairs(item:GetDescendants()) do
        local text = readObjectText(obj)

        if text and text ~= ""
            and not tonumber(text)
            and not parseCount(text,false)
            and string.lower(obj.Name) ~= "itemcount" then
            return text
        end
    end

    return "Pet "..tostring(id)
end

local function getInventoryPetItems()
    local results = {}
    local seen = {}

    if not Inventory then return results end

    for _,item in ipairs(Inventory:GetChildren()) do
        local id = tonumber(item.Name)

        if id and not seen[id] then
            seen[id] = true
            local count = getCount(id)

            if count > 0 then
                table.insert(results,{
                    id=id,
                    count=count,
                    name=getPetName(id)
                })
            end
        end
    end

    table.sort(results,function(a,b)
        return a.name:lower() < b.name:lower()
    end)

    return results
end

local function getHeldPet()
    local char = Player.Character
    if not char then return nil end

    for _,obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") and tonumber(obj.Name) then
            return obj.Name
        end
    end
end

