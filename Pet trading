local dropRunning=false
local dropSession=0
local selectedPetId=nil
local selectedPetName=nil
local dropSentCount=0

local function showDropPanel(parent)
    local panel=new("Frame",{
        Size=UDim2.new(1,-4,0,43),
        BackgroundColor3=CARD,
        BorderSizePixel=0,
        ClipsDescendants=true
    },parent)

    corner(panel,11)
    addNeon(panel,ORANGE)

    local head=button(panel,"🐾  AUTO DROP",
        UDim2.new(0,8,0,5),UDim2.new(1,-16,0,32),PANEL,nil,12)
    head.TextXAlignment=Enum.TextXAlignment.Left
    head.TextColor3=ORANGE

    local arrow=label(head,"▼",
        UDim2.new(1,-30,0,0),UDim2.fromOffset(22,32),ORANGE,12,true)
    arrow.TextXAlignment=Enum.TextXAlignment.Center

    local body=new("Frame",{
        Position=UDim2.new(0,8,0,43),
        Size=UDim2.new(1,-16,0,165),
        BackgroundTransparency=1
    },panel)

    local saved=label(body,"SAVED ID: NONE",
        UDim2.new(0,2,0,0),UDim2.new(1,-4,0,20),ORANGE,10,true)

    local name=label(body,"Hold a pet and press SET ID",
        UDim2.new(0,2,0,21),UDim2.new(1,-4,0,19),WHITE,10,false)

    local status=label(body,"STATUS: IDLE",
        UDim2.new(0,2,0,44),UDim2.new(1,-4,0,18),MUTED,10,true)

    local progress=label(body,"DROP SENT: 0",
        UDim2.new(0,2,0,65),UDim2.new(1,-4,0,18),WHITE,10,true)

    local set=button(body,"SET ID",
        UDim2.new(0,0,0,94),UDim2.new(.34,-4,0,34),ORANGE,nil,10)

    local start=button(body,"▶ START",
        UDim2.new(.34,2,0,94),UDim2.new(.33,-4,0,34),GREEN,nil,10)

    local stop=button(body,"■ STOP",
        UDim2.new(.67,4,0,94),UDim2.new(.33,-4,0,34),RED,nil,10)

    addGloss(set,ORANGE)
    addGloss(start,GREEN)
    addGloss(stop,RED)

    local expanded=false

    local function statusText(text,color)
        if status.Parent then
            status.Text="STATUS: "..text
            status.TextColor3=color or MUTED
        end
    end

    local function heldTool(id)
        local char=Player.Character
        if not char then return nil end
        for _,obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") and obj.Name==tostring(id) then
                return obj
            end
        end
    end

    head.Activated:Connect(function()
        expanded=not expanded
        tween(panel,TweenInfo.new(.2),{
            Size=UDim2.new(1,-4,0,expanded and 210 or 43)
        })
        arrow.Text=expanded and "▲" or "▼"
    end)

    set.Activated:Connect(function()
        if dropRunning then
            statusText("STOP BEFORE CHANGING ID",RED)
            return
        end

        local held=getHeldPet()
        if not held then
            statusText("HOLD A PET FIRST",RED)
            return
        end

        selectedPetId=held
        selectedPetName=getPetName(held)
        dropSentCount=0

        saved.Text="SAVED ID: "..held
        name.Text=selectedPetName
        progress.Text="DROP SENT: 0"
        statusText("ID SAVED",GREEN)
    end)

    stop.Activated:Connect(function()
        dropSession+=1
        dropRunning=false
        start.Text="▶ START"
        statusText("STOPPED",RED)
    end)

    start.Activated:Connect(function()
        if dropRunning then return end
        if not AutoDropRemote then
            statusText("REMOTE NOT FOUND",RED)
            return
        end
        if not selectedPetId then
            statusText("SET ID FIRST",RED)
            return
        end

        dropSession+=1
        local session=dropSession
        dropRunning=true
        start.Text="RUNNING..."

        task.spawn(function()
            while dropRunning and dropSession==session and panel.Parent do
                local current=getHeldPet()

                if current and current~=selectedPetId then
                    statusText("REMOVE OTHER PET",RED)
                    task.wait(.3)
                    continue
                end

                if not current then
                    statusText("TAKING PET",ORANGE)

                    pcall(function()
                        AutoDropRemote:FireServer(
                            "TakeTool",
                            tonumber(selectedPetId)
                        )
                    end)

                    local deadline=os.clock()+1.5
                    repeat
                        task.wait(.05)
                        current=getHeldPet()
                    until current or os.clock()>deadline
                        or not dropRunning or dropSession~=session

                    if not current then
                        statusText("PET NOT RECEIVED",RED)
                        task.wait(.6)
                        continue
                    end
                end

                local tool=heldTool(selectedPetId)

                if not tool then
                    task.wait(.2)
                    continue
                end

                task.wait(.15)

                if heldTool(selectedPetId)~=tool then
                    task.wait(.3)
                    continue
                end

                statusText("DROPPING",ORANGE)

                local ok=pcall(function()
                    AutoDropRemote:FireServer("Drop")
                end)

                if ok then
                    dropSentCount+=1
                    progress.Text="DROP SENT: "..dropSentCount
                end

                local deadline=os.clock()+1.5
                repeat
                    task.wait(.05)
                until not tool.Parent
                    or not Player.Character
                    or not tool:IsDescendantOf(Player.Character)
                    or os.clock()>deadline
                    or not dropRunning
                    or dropSession~=session

                if tool.Parent and Player.Character
                    and tool:IsDescendantOf(Player.Character) then
                    statusText("DROP NOT CONFIRMED",RED)
                    task.wait(.8)
                else
                    statusText("DROP CONFIRMED",GREEN)
                    task.wait(.35)
                end
            end

            if dropSession==session then
                dropRunning=false
                start.Text="▶ START"
                statusText("STOPPED",MUTED)
            end
        end)
    end)

    panel.Destroying:Connect(function()
        dropSession+=1
        dropRunning=false
    end)
end

