        Position = UDim2.new(0, 8, 0, 78),
        BackgroundColor3 = COLORS.Panel,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = COLORS.Orange,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y
    }, body)

    corner(list, 8)

    new("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, list)

    new("UIPadding", {
        PaddingTop = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6)
    }, list)

    local function refresh()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("GuiObject") and not child:IsA("UIListLayout")
                and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end

        local pets = getSellPetList()

        for _, pet in ipairs(pets) do
            local row = new("Frame", {
                Size = UDim2.new(1, -5, 0, 39),
                BackgroundColor3 = COLORS.PanelLight,
                BorderSizePixel = 0
            }, list)

            corner(row, 7)

            label(
                row,
                "Pet ID: " .. tostring(pet.id),
                UDim2.new(0.55, 0, 1, 0),
                UDim2.new(0, 9, 0, 0),
                11,
                COLORS.Text
            )

            label(
                row,
                "x" .. tostring(pet.count),
                UDim2.new(0, 45, 1, 0),
                UDim2.new(0.58, 0, 0, 0),
                11,
                COLORS.SubText
            )

            local check = new("TextButton", {
                Size = UDim2.new(0, 25, 0, 25),
                Position = UDim2.new(1, -32, 0.5, -12),
                BackgroundColor3 = COLORS.Panel,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false
            }, row)

            corner(check, 6)
            stroke(check, COLORS.Orange, 1, 0.2)

            local selected = AutoSellMode == "Single"
                and SelectedSinglePet == pet.id
                or SelectedSellPets[pet.id] == true

            local mark = label(
                check,
                selected and "✓" or "",
                UDim2.new(1, 0, 1, 0),
                UDim2.new(0, 0, 0, 0),
                15,
                COLORS.Green
            )

            mark.TextXAlignment = Enum.TextXAlignment.Center

            check.MouseButton1Click:Connect(function()
                if AutoSellMode == "Single" then
                    if SelectedSinglePet == pet.id then
                        SelectedSinglePet = nil
                    else
                        SelectedSinglePet = pet.id
                    end
                else
                    SelectedSellPets[pet.id] = not SelectedSellPets[pet.id]
                        and true or nil
                end

                refresh()
            end)
        end
    end

    modeButton.MouseButton1Click:Connect(function()
        if AutoSellMode == "Single" then
            AutoSellMode = "Multi"
            modeButton.Text = "MODE: MULTI"
        else
            AutoSellMode = "Single"
            modeButton.Text = "MODE: SINGLE"
        end

        refresh()
    end)

    refreshButton.MouseButton1Click:Connect(refresh)

    sellButton.MouseButton1Click:Connect(function()
        if AutoSellMode == "Single" then
            if SelectedSinglePet then
                sellPet(SelectedSinglePet, getPetCount(SelectedSinglePet))
            end
        else
            for petId, selected in pairs(SelectedSellPets) do
                if selected then
                    sellPet(petId, getPetCount(petId))
                end
            end
        end

        task.wait(0.25)
        refresh()
    end)

    refresh()
end

