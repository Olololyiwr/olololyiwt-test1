    tween(Pill,TweenInfo.new(.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
        Position=UDim2.new(.5,0,0,12)
    })

    busy = false
end)

Pill.Activated:Connect(function()
    if busy or not isMinimized then return end

    busy = true

    tween(Pill,TweenInfo.new(.2),{
        Position=UDim2.new(.5,0,0,-55)
    })

    task.wait(.18)

    Pill.Visible = false
    Main.Visible = true
    Main.Position = UDim2.new(.5,0,.58,0)
    Main.BackgroundTransparency = 1

    tween(Main,TweenInfo.new(.32,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{
        Position=UDim2.new(.5,0,.52,0),
        BackgroundTransparency=0
    })

    isMinimized = false
    busy = false
end)

-- CLOSE

Close.Activated:Connect(function()
    dropRunning = false

    tween(Main,TweenInfo.new(.2),{
        Size=UDim2.new(.8,0,.6,0),
        BackgroundTransparency=1
    })

    task.wait(.2)
    Gui:Destroy()
end)

