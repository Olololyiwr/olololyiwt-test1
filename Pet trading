local function createNavButton(name, icon, order, callback)
    local navButton = new("TextButton", {
        Name = name .. "Button",
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = COLORS.Panel,
        BorderSizePixel = 0,
        Text = icon .. "  " .. name,
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        LayoutOrder = order
    }, Nav)

    corner(navButton, 7)

    new("UIPadding", {
        PaddingLeft = UDim.new(0, 9)
    }, navButton)

    local outline = stroke(navButton, COLORS.Orange, 1, 1)

    navButton.MouseEnter:Connect(function()
        if CurrentTab ~= name then
            tween(navButton, {
                BackgroundColor3 = COLORS.PanelLight
            }, 0.15)
        end
    end)

    navButton.MouseLeave:Connect(function()
        if CurrentTab ~= name then
            tween(navButton, {
                BackgroundColor3 = COLORS.Panel
            }, 0.15)
        end
    end)

    navButton.MouseButton1Click:Connect(function()
        CurrentTab = name

        for _, child in ipairs(Nav:GetChildren()) do
            if child:IsA("TextButton") then
                tween(child, {
                    BackgroundColor3 = COLORS.Panel
                }, 0.12)

                local childStroke = child:FindFirstChildOfClass("UIStroke")

                if childStroke then
                    tween(childStroke, {
                        Transparency = 1
                    }, 0.12)
                end
            end
        end

        tween(navButton, {
            BackgroundColor3 = COLORS.PanelLight
        }, 0.12)

        tween(outline, {
            Transparency = 0
        }, 0.12)

        SearchBox.Text = ""

        callback()
    end)

    return navButton
end

