local function getCategoryGradient(category)
    if category == "Gold" then
        return GoldGradient
    elseif category == "Colored" then
        return ColoredGradient
    end

    return RainbowGradient
end

local function applyTitleGradient(object, category)
    local gradient = object:FindFirstChildOfClass("UIGradient")

    if not gradient then
        gradient = new("UIGradient", {}, object)
    end

    gradient.Color = getCategoryGradient(category)
    gradient.Rotation = 0

    return gradient
end

