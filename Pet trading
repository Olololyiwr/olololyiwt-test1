    -- SELL REQUEST
    -- Giữ nguyên remote và tham số gốc của script.

    local function sendSellRequest(id,amount)
        if not SellRemote then
            return false,0,"Sell remote not found"
        end

        local before = getCount(id)

        if before <= 0 then
            return false,0,"Pet count is zero"
        end

        amount = math.min(amount,before)

        local ok,err = pcall(function()
            SellRemote:FireServer("sell",id,amount)

            if getHeldPet() == tostring(id) and PickAndDropRemote then
                PickAndDropRemote:FireServer("Sell")
            end
        end)

        if not ok then
            return false,0,tostring(err)
        end

        local deadline = os.clock()+5

        repeat
            task.wait(.1)

            local current = getCount(id)
            local sold = math.max(0,before-current)

            if sold > 0 then
                return true,sold,"Sold"
            end
        until os.clock() >= deadline

        return false,0,"No inventory change detected"
    end

