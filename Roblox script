local Inventory

pcall(function()
    Inventory=PlayerGui:WaitForChild("ShopAndInventoryGui")
        :WaitForChild("InventoryFrame")
        :WaitForChild("ScrollingFrame")
end)

local function readText(obj)
    local ok,value=pcall(function() return obj.Text end)
    if ok and value~=nil then return tostring(value) end
end

local function parseCount(text,allowPlain)
    if text == nil then return nil end

    local cleaned=tostring(text):gsub(",",""):gsub("%s+","")

    local n=cleaned:match("[xX](%d+)")
        or cleaned:match("(%d+)[xX]")

    if n then
        return tonumber(n)
    end

    if allowPlain and cleaned:match("^%d+$") then
        return tonumber(cleaned)
    end

    return nil
end

local function getCount(id)
    if not Inventory then return 0 end
    local item=Inventory:FindFirstChild(tostring(id))
    if not item then return 0 end

    for _,obj in ipairs(item:GetDescendants()) do
        local n=string.lower(obj.Name)
        if n=="itemcount" or n=="count" or n=="amount"
            or n=="quantity" or n=="countlabel" then
            local amount=parseCount(readText(obj),true)
            if amount then return amount end
        end
    end

    for _,attribute in ipairs({"ItemCount","Count","Amount","Quantity"}) do
        local v=item:GetAttribute(attribute)
        if tonumber(v) then return math.max(0,tonumber(v)) end
    end

    return 1
end

local function getPetName(id)
    if not Inventory then return "Pet "..tostring(id) end
    local item=Inventory:FindFirstChild(tostring(id))
    if not item then return "Pet "..tostring(id) end

    for _,name in ipairs({"NameLabel","PetName","DisplayName","ItemName"}) do
        local obj=item:FindFirstChild(name,true)
        local text=obj and readText(obj)
        if text and text~="" and not tonumber(text) then
            return text
        end
    end

    return "Pet "..tostring(id)
end

local function getInventoryPets()
    local results={}
    if not Inventory then return results end

    for _,item in ipairs(Inventory:GetChildren()) do
        local id=tonumber(item.Name)
        if id then
            local count=getCount(id)
            if count>0 then
                table.insert(results,{
                    id=id,
                    count=count,
                    name=getPetName(id)
                })
            end
        end
    end

    table.sort(results,function(a,b)
        return a.name:lower()<b.name:lower()
    end)

    return results
end

local function getHeldPet()
    local char=Player.Character
    if not char then return nil end
    for _,obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") and tonumber(obj.Name) then
            return obj.Name
        end
    end
end

