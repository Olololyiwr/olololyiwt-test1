local function showPets(pets,category)
    clearContent()
    Search.Visible=true

    local scroll=createList()

    local headerText = category=="Gold" and "🪙 GOLD PETS"
        or category=="Rainbow" and "🌈 RAINBOW PETS"
        or "🎨 COLORED PETS"

    local header=new("TextLabel",{
        Size=UDim2.new(1,-4,0,34),
        BackgroundTransparency=1,
        Text=headerText,
        TextColor3=WHITE,
        Font=Enum.Font.GothamBold,
        TextSize=15,
        TextXAlignment=Enum.TextXAlignment.Center
    },scroll)

    if category=="Gold" or category=="Rainbow" then
        applyAnimatedGradient(header, category)
    end

    local query=(Search.Text or ""):lower()
    local count=0

    for _,pet in ipairs(pets) do
        local name,id=pet[1],pet[2]

        if query==""
            or name:lower():find(query,1,true)
            or tostring(id):find(query,1,true) then

            count+=1
            makePetButton(scroll,pet,category)
        end
    end

    if count==0 then
        label(scroll,"No pets found.",
            UDim2.new(),UDim2.new(1,0,0,45),MUTED,13,false)
    end
end

