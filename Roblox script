local function decoratePetName(name)
    local raw=tostring(name or "Unknown Pet")

    local existing={
        "🐰","🐱","🐶","🐻","🐘","🐭","🦇","🦌",
        "🐺","🐢","🐝","🦏","🐃","🐨","🐲","🦖",
        "🥷","😇","🛡","👽","🐙","🦈","🤖","👹",
        "🍬","🦆","🐧","❄","🦊","🐷","🐵","🦎",
        "🕷","🌋","🐸","🦀","🦁","🦔","🦄","🦋",
        "👻","⭐","🦃","🐼","⚡","🎃","💀","👑",
        "🌹","⚙","📺","🎧","🪽","🍭","⚔","🧸",
        "🫧","🌀","🪶","✨","🔄","🧽","🖥","❓","🌈","🪙"
    }

    for _,emoji in ipairs(existing) do
        if raw:find(emoji,1,true) then
            return raw
        end
    end

    local lower=raw:lower()

    for _,rule in ipairs(PetEmojiRules) do
        if lower:find(rule[1]:lower(),1,true) then
            return rule[2].." "..raw
        end
    end

    return "✨ "..raw
end

local function formatDisplayPetName(name, category)
    local decorated = decoratePetName(name)
    if category == "Rainbow" then
        if not decorated:find("🌈", 1, true) then
            decorated = "🌈 " .. decorated
        end
    elseif category == "Gold" then
        if not decorated:find("🪙", 1, true) then
            decorated = "🪙 " .. decorated
        end
    elseif category == "Colored" then
        return decorated .. ' <font color="#2ECC71">$R</font>'
    end
    return decorated
end

