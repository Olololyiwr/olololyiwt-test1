            or "Choose one pet"

        choose.Text=selectedOne
            and (decoratePetName(getPetName(selectedOne)).."  ▼")
            or "Choose pet  ▼"
    end

    -- REFRESH INVENTORY
    local function refreshList()
        for _,obj in ipairs(list:GetChildren()) do
            if obj:IsA("GuiObject") then
                obj:Destroy()
            end
        end

        local query=search.Text:lower()
        local entries=getInventoryPets()
        local found=0

        for _,entry in ipairs(entries) do
            local matches=query==""
                or entry.name:lower():find(query,1,true)
                or tostring(entry.id):find(query,1,true)

            if matches then
                found+=1

                local isSelected=selectedOne==entry.id

                local row=new("TextButton",{
                    Size=UDim2.new(1,-3,0,31),
                    BackgroundColor3=isSelected
                        and Color3.fromRGB(78,52,29)
                        or CARD,
                    Text=(isSelected and "✓  " or "○  ")
                        ..decoratePetName(entry.name)
                        .."  x"..entry.count,
                    TextColor3=WHITE,
                    Font=Enum.Font.Gotham,
                    TextSize=10,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    BorderSizePixel=0,
                    AutoButtonColor=true,
                    Active=true,
                    Selectable=true,
                    ZIndex=52
                },list)

                corner(row,6)

                row.Activated:Connect(function()
                    if busy then return end

                    selectedOne=entry.id
                    quantity=1
                    quantityBox.Text="1"

                    dropdown=false
                    menu.Visible=false

                    updateInfo()
                    refreshList()
                end)
            end
        end

        if found==0 then
            local empty=label(list,"No pets found",
                UDim2.new(),UDim2.new(1,0,0,27),MUTED,10,false)
            empty.ZIndex=52
        end
    end

    -- QUANTITY
    local function setQuantity(value)
        local count=selectedOne and getCount(selectedOne) or 1

        quantity=math.clamp(
            math.floor(tonumber(value) or 1),
            1,
            math.max(1,count)
        )

        quantityBox.Text=tostring(quantity)
    end

    -- SELL REQUEST
    local function sendSell(id,amount)
        if not SellRemote then
            return false,0,false
        end

        id=tonumber(id)
        amount=math.floor(tonumber(amount) or 0)

        if not id or amount<=0 then
            return false,0,false
        end

        local before=getCount(id)
        if before<=0 then
            return false,0,false
        end

        amount=math.min(amount,before)

        local ok,err=pcall(function()
            SellRemote:FireServer("sell",id,amount)
        end)

        if not ok then
            warn("[Pet Hub] Sell request error:",err)
            return false,0,false
        end

        local deadline=os.clock()+2.5

        repeat
            task.wait(.1)

            local after=getCount(id)
            local sold=math.max(0,before-after)

            if sold>0 then
                return true,sold,true
            end
        until os.clock()>=deadline

        return true,0,false
    end

    local function setBusy(value)
        busy=value
        sellOne.Active=not value
        choose.Active=not value
        minus.Active=not value
        plus.Active=not value
        max.Active=not value
        quantityBox.TextEditable=not value

        sellOne.Text=value and "SELLING..." or "SELL ONE"
    end

    -- DROPDOWN
    choose.Activated:Connect(function()
        if busy then return end

        dropdown=not dropdown
        menu.Visible=dropdown

        if dropdown then
            search.Text=""
            refreshList()
        end
    end)

    search:GetPropertyChangedSignal("Text"):Connect(function()
        refreshList()
    end)

    -- QUANTITY BUTTONS
    minus.Activated:Connect(function()
        if not busy then
            setQuantity(quantity-1)
        end
    end)

    plus.Activated:Connect(function()
        if not busy then
            setQuantity(quantity+1)
        end
    end)

    max.Activated:Connect(function()
        if not busy and selectedOne then
            setQuantity(getCount(selectedOne))
        end
    end)

    quantityBox.FocusLost:Connect(function()
        if not busy then
            setQuantity(quantityBox.Text)
        end
    end)

    -- SELL ONE
    sellOne.Activated:Connect(function()
        if busy then return end

        if not selectedOne then
            info.Text="Choose a pet first"
            return
        end

        local id=selectedOne
        local amount=math.min(quantity,getCount(id))

        if amount<=0 then
            info.Text="Pet unavailable"
            return
        end

        setBusy(true)

        task.spawn(function()
            local sent,sold,confirmed=sendSell(id,amount)

            setBusy(false)
            updateInfo()
            refreshList()

            if confirmed then
                info.Text="Sold "..sold.." "
                    ..decoratePetName(getPetName(id))
            elseif sent then
                info.Text="Request sent • Not confirmed"
            else
                info.Text="Sell request failed"
            end
        end)
    end)

    -- PANEL OPEN / CLOSE
    head.Activated:Connect(function()
        expanded=not expanded

        dropdown=false
        menu.Visible=false

        tween(panel,TweenInfo.new(.2),{
            Size=UDim2.new(1,-4,0,expanded and 343 or 43)
        })

        arrow.Text=expanded and "▲" or "▼"
    end)

    updateInfo()
    refreshList()
end

